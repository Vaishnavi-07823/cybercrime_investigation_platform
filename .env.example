# Application
APP_NAME=Cybercrime Investigation Platform
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Seed administrator
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=ChangeMeNow!123
ADMIN_NAME=Platform Administrator

# PostgreSQL
POSTGRES_DB=cybercrime
POSTGRES_USER=cybercrime
POSTGRES_PASSWORD=cybercrime_dev_password
DATABASE_URL=postgresql+psycopg://cybercrime:cybercrime_dev_password@postgres:5432/cybercrime

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_EVIDENCE_BUCKET=evidence
MINIO_REPORT_BUCKET=reports

# OpenSearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=normalized-events
OPENSEARCH_VERIFY_CERTS=false

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password

# Optional OpenAI-compatible LLM endpoint.
# Safe deterministic narratives are used when LLM_PROVIDER=none.
LLM_PROVIDER=none
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=local-development-key
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=90

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
